FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /workspace

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates file \
 && rm -rf /var/lib/apt/lists/*
USER 1000

# Build with the google-cloud-java repository root as the Docker context.
# Example from java-spanner/: docker build -f Dockerfile.ycsb -t java-spanner-ycsb:test ..
COPY --chown=1000:1000 sdk-platform-java /workspace/sdk-platform-java
COPY --chown=1000:1000 google-cloud-pom-parent /workspace/google-cloud-pom-parent
COPY --chown=1000:1000 google-cloud-jar-parent /workspace/google-cloud-jar-parent
COPY --chown=1000:1000 java-spanner /workspace/java-spanner

# Some local sdk-platform-java checkouts can temporarily reference an unpublished
# google-auth BOM version in gapic-generator-java-bom/pom.xml. Align it with the
# tested version recorded in dependencies.txt before bootstrapping Maven artifacts.
RUN GOOGLE_AUTH_VERSION="$(sed -n 's/^com.google.auth:google-auth-library-bom,google.auth=//p' /workspace/sdk-platform-java/dependencies.txt | head -n 1)" \
 && test -n "${GOOGLE_AUTH_VERSION}" \
 && sed -i "s#<version>1.44.0</version><!-- {x-version-update:google-auth-library:current} -->#<version>${GOOGLE_AUTH_VERSION}</version><!-- {x-version-update:google-auth-library:current} -->#g" /workspace/sdk-platform-java/gapic-generator-java-bom/pom.xml

# Bootstrap the local SNAPSHOT artifacts required by java-spanner.
RUN mvn -f /workspace/sdk-platform-java/pom.xml -pl gapic-generator-java-bom,java-core/google-cloud-core-bom -am clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/java-shared-dependencies/third-party-dependencies/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/api-common-java/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/java-common-protos/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/gax-java/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/java-shared-dependencies/first-party-dependencies/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/java-shared-dependencies/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/java-iam/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip
RUN mvn -f /workspace/sdk-platform-java/java-core/pom.xml clean install -DskipTests -Dmaven.test.skip=true -Dcheckstyle.skip

# Build the java-spanner library and then the YCSB shaded jar.
RUN mvn -f /workspace/java-spanner/pom.xml install -DskipTests -Dmaven.test.skip=true -Dclirr.skip -Dmaven.javadoc.skip=true -Dcheckstyle.skip -pl google-cloud-spanner -am
RUN mvn -f /workspace/java-spanner/ycsb/pom.xml -pl cloudspanner -am package \
    -DskipTests \
    -Dcheckstyle.skip=true
RUN mkdir -p /tmp/out/lib /tmp/out/bin /tmp/out/cloudspanner-binding/lib /tmp/out/cloudspanner-binding/conf /tmp/out/cloudspanner/conf /tmp/out/workloads
RUN CORE_JAR="$(find /workspace/java-spanner/ycsb/core/target -maxdepth 1 -type f -name 'core-*.jar' ! -name '*-tests.jar' ! -name 'original-*' | head -n 1)" \
    && test -n "${CORE_JAR}" \
    && echo "Found core jar: ${CORE_JAR}" \
    && cp "${CORE_JAR}" /tmp/out/lib/core.jar
RUN YCSB_BINDING_JAR="$(find /workspace/java-spanner/ycsb/cloudspanner/target -maxdepth 1 -type f -name 'cloudspanner-binding-*.jar' ! -name '*-tests.jar' ! -name 'original-*' | head -n 1)" \
    && test -n "${YCSB_BINDING_JAR}" \
    && echo "Found cloudspanner binding jar: ${YCSB_BINDING_JAR}" \
    && cp "${YCSB_BINDING_JAR}" /tmp/out/cloudspanner-binding/lib/cloudspanner-binding.jar
RUN mvn -f /workspace/java-spanner/ycsb/core/pom.xml dependency:copy-dependencies \
    -DincludeScope=runtime \
    -DoutputDirectory=/tmp/out/lib \
    -DskipTests
RUN cp -r /workspace/java-spanner/ycsb/bin/. /tmp/out/bin/
RUN cp -r /workspace/java-spanner/ycsb/cloudspanner/conf/. /tmp/out/cloudspanner-binding/conf/
RUN cp -r /workspace/java-spanner/ycsb/cloudspanner/conf/. /tmp/out/cloudspanner/conf/
RUN cp -r /workspace/java-spanner/ycsb/workloads/. /tmp/out/workloads/
RUN cp /workspace/java-spanner/ycsb/LICENSE.txt /tmp/out/LICENSE.txt
RUN cp /workspace/java-spanner/ycsb/NOTICE.txt /tmp/out/NOTICE.txt

FROM hengyunabc/arthas:latest AS arthas

FROM eclipse-temurin:17-jdk

WORKDIR /ycsb

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python-is-python3 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /tmp/out/lib /ycsb/lib
COPY --from=build /tmp/out/bin /ycsb/bin
COPY --from=build /tmp/out/cloudspanner-binding /ycsb/cloudspanner-binding
COPY --from=build /tmp/out/cloudspanner /ycsb/cloudspanner
COPY --from=build /tmp/out/workloads /ycsb/workloads
COPY --from=build /tmp/out/LICENSE.txt /ycsb/LICENSE.txt
COPY --from=build /tmp/out/NOTICE.txt /ycsb/NOTICE.txt
COPY --from=arthas /opt/arthas /opt/arthas

ENTRYPOINT ["/ycsb/bin/ycsb"]
